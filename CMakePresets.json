{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 4,
        "patch": 2
    },
    "configurePresets": [
        {
            "name": "arm-linux-gnueabihf",
            "hidden": true,
            "displayName": "Configure for Raspberry Pi Zero W",
            "description": "Configures the project to use the Raspberry Pi toolchain",
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/toolchain/arm-linux-gnueabihf.cmake",
            "environment": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "arm-linux-gnueabihf-release",
            "displayName": "Release Raspberry Pi Zero W ",
            "description": "Configures the project to use the Raspberry Pi toolchain",
            "binaryDir": "out/build-arm-linux-gnueabihf-release",
            "installDir": "out/dist/arm-linux-gnueabihf-release",
            "toolchainFile": "${sourceDir}/toolchain/arm-linux-gnueabihf.cmake",
            "environment": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "arm-linux-gnueabihf-debug",
            "displayName": "Debug Raspberry Pi Zero W ",
            "description": "Configures the project to use the Raspberry Pi toolchain",
            "binaryDir": "out/build-arm-linux-gnueabihf-debug",
            "installDir": "out/dist/arm-linux-gnueabihf-debug",
            "toolchainFile": "${sourceDir}/toolchain/arm-linux-gnueabihf.cmake",
            "environment": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x86_64",
            "hidden": true,
            "displayName": "x86_64",
            "description": "Native build",
            "generator": "Ninja",
            "environment": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "x86_64-release",
            "displayName": "x86_64-release",
            "description": "Native build",
            "generator": "Ninja",
            "binaryDir": "out/native-release",
            "installDir": "out/dist/native-release",
            "environment": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x86_64-debug",
            "displayName": "x86_64-debug",
            "description": "Native build",
            "generator": "Ninja",
            "binaryDir": "out/native-debug",
            "installDir": "out/dist/native-debug",
            "environment": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
  "vendor": {
    "microsoft.com/VisualStudio": {
      "enableClangTidy": true
      }
    }
}